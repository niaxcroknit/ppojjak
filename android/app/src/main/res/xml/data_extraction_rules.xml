<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : 클라우드 백업과 기기 간 이전 모두 게임 진행(WebView localStorage)을 포함 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_webview/" />
        <exclude domain="root" path="app_webview/Default/GPUCache/" />
        <exclude domain="root" path="app_webview/Default/Code Cache/" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/" />
        <exclude domain="root" path="app_webview/Default/GPUCache/" />
        <exclude domain="root" path="app_webview/Default/Code Cache/" />
    </device-transfer>
</data-extraction-rules>
